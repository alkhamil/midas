{
  "name": "midas-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @midas/server & npm run dev --workspace @midas/studio",
    "dev:studio": "npm run dev --workspace @midas/studio",
    "dev:server": "npm run dev --workspace @midas/server",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @midas/server",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=22"
  }
}
