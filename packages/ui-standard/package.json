{
  "name": "@midas/ui-standard",
  "version": "1.0.0",
  "description": "Standard component kit of Midas (React + Tailwind CSS v4): the behaviour of the CMS components. A library publish in Midas swaps its generated layer (tokens, props types, icons) for the library's own.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./manifest.json": "./dist/manifest.json",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build && node scripts/copy-assets.mjs && node scripts/build-studio-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  },
  "private": true
}
