{
  "name": "@midas/ui-cms",
  "version": "2.5.0",
  "description": "Komponen UI dari design system \"CMS Design System\" di Midas (React + Tailwind CSS v4)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./manifest.json": "./dist/manifest.json",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "sync": "midas sync",
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --test test/*.test.mjs",
    "bundle": "midas bundle"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@midas/cli": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^6.0.7"
  },
  "publishConfig": {
    "registry": "http://127.0.0.1:4873/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
