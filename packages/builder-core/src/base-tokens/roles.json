{
  "bg": { "base": "Semantic/colorBgContainer" },
  "bg-subtle": { "base": "Semantic/colorBgLayout" },
  "fg": { "base": "Semantic/colorText" },
  "border": { "base": "Semantic/colorBorder" },
  "border-hover": { "base": "Semantic/colorPrimaryHover", "derive": { "from": "Primitives/primary/600" } },
  "border-focus": { "base": "Semantic/colorPrimary" },
  "placeholder": { "base": "Semantic/colorTextDisabled" },
  "bg-disabled": { "base": "Semantic/colorBgContainerDisabled", "derive": { "from": "Primitives/neutral/200" } },
  "fg-disabled": { "base": "Semantic/colorTextDisabled" },
  "text": { "base": "Semantic/colorText" },
  "brand": { "base": "Semantic/colorPrimary" },
  "brand-hover": { "base": "Semantic/colorPrimaryHover", "derive": { "from": "Primitives/primary/600" } },
  "brand-active": { "base": "Semantic/colorPrimaryActive", "derive": { "from": "Primitives/primary/700" } },
  "danger": { "base": "Semantic/colorError" },
  "danger-hover": { "base": "Semantic/colorErrorHover", "derive": { "from": "Primitives/danger/600" } },
  "danger-active": { "base": "Semantic/colorErrorActive", "derive": { "from": "Primitives/danger/700" } },
  "error": { "base": "Semantic/colorError" },
  "error-hover": { "base": "Semantic/colorErrorHover", "derive": { "from": "Primitives/danger/600" } },
  "warning": { "base": "Semantic/colorWarning" },
  "warning-hover": { "base": "Semantic/colorWarningHover", "derive": { "from": "Primitives/warning/600" } },
  "outline": { "base": "Semantic/colorPrimaryOutline", "derive": { "from": "Primitives/primary/500", "opacity": 20 } },
  "danger-outline": { "base": "Semantic/colorErrorOutline", "derive": { "from": "Primitives/danger/500", "opacity": 20 } },
  "warning-outline": { "base": "Semantic/colorWarningOutline", "derive": { "from": "Primitives/warning/500", "opacity": 20 } },
  "brand-bg": { "base": "Semantic/colorPrimaryBg", "derive": { "from": "Primitives/primary/50" } },
  "brand-bg-hover": { "base": "Semantic/colorPrimaryBgHover", "derive": { "from": "Primitives/primary/100" } },
  "danger-bg": { "base": "Semantic/colorErrorBg", "derive": { "from": "Primitives/danger/50" } },
  "danger-bg-hover": { "base": "Semantic/colorErrorBgHover", "derive": { "from": "Primitives/danger/100" } },
  "solid-text": { "base": "Icons/icons/on-brand" },
  "height": { "base": "Size/controlHeight" },
  "height-sm": { "base": "Size/controlHeightSM" },
  "height-lg": { "base": "Size/controlHeightLG" },
  "font": { "base": "Size/fontSize" },
  "font-sm": { "base": "Size/fontSizeSM" },
  "font-lg": { "base": "Size/fontSizeLG" },
  "line": { "base": "Size/lineHeight" },
  "line-sm": { "base": "Size/lineHeightSM" },
  "line-lg": { "base": "Size/lineHeightLG" },
  "padding-sm": { "base": "Size/paddingSM" },
  "padding-xs": { "base": "Size/paddingXS" },
  "gap": { "base": "Size/marginXS" },
  "radius": { "base": "Size/borderRadius" },
  "icon": { "base": "Icons/size/16" },
  "icon-sm": { "base": "Icons/size/14" }
