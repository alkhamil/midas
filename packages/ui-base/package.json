{
  "name": "@midas/ui-base",
  "version": "2.1.0",
  "description": "Komponen UI dari design system \"Midas Base\" di Midas (React + Tailwind CSS v4)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./manifest.json": "./dist/manifest.json",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "sync": "midas sync",
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "i18next": ">=23",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7.50",
    "react-i18next": ">=14",
    "react-router": ">=7"
  },
  "devDependencies": {
    "@midas/cli": "^0.1.0",
    "@types/react": "^19.2.18",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4",
    "typescript": "~5.9.0",
    "vite": "^6.0.7"
  },
  "publishConfig": {
    "registry": "http://127.0.0.1:4873/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "react-datepicker": "^9.1.0"
  }
}
