{
  "name": "@midas/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@types/react": "^19.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.25.0",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "typescript": "~5.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
