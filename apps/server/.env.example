PORT=4000
DATABASE_URL=postgres://midas:midas@127.0.0.1:5433/midas
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=midas
S3_SECRET_KEY=midas-secret
S3_BUCKET=midas
# Ukuran body maksimum (MB) untuk import file besar.
BODY_LIMIT_MB=512
# Akun administrator pertama (seeder, dijalankan otomatis saat server start dan lewat `npm run db:seed`).
# Tidak ada pendaftaran: akun lain dibuat administrator di menu Users. Tanpa password: `admin12345` (dev) atau acak (production, dicetak sekali).
SEED_ADMIN_EMAIL=admin@midas.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=admin12345
COOKIE_SECURE=false

# --- Hosting (see docs/deploy-gratis.md) ---
# Interface to listen on (0.0.0.0 in a container), apply migrations at startup, and serve apps/studio/dist.
# HOST=0.0.0.0
# AUTO_MIGRATE=true
# STUDIO_DIST=/app/apps/studio/dist
