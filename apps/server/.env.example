PORT=4000
DATABASE_URL=postgres://midas:midas@127.0.0.1:5433/midas
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=midas
S3_SECRET_KEY=midas-secret
S3_BUCKET=midas
# Ukuran body maksimum (MB) untuk import file besar.
BODY_LIMIT_MB=512
# Izinkan pendaftaran akun dari halaman login (akun pertama selalu diizinkan).
ALLOW_REGISTER=true
COOKIE_SECURE=false
# URL yang ditulis ke repo paket library (midas.config.json, .npmrc).
MIDAS_PUBLIC_URL=http://127.0.0.1:4000
REGISTRY_URL=http://127.0.0.1:4873/
# Masa berlaku token CLI/CI (hari).
TOKEN_DAYS=365
